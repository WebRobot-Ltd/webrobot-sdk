<?xml version="1.0" encoding="UTF-8"?>
<!--
  Deploy: endpoint ossrh-staging-api.central.sonatype.com (vedi pom distributionManagement).

  Autenticazione Maven (Basic su <server id>ossrh): serve un CENTRAL PORTAL USER TOKEN,
  NON la vecchia password/token OSSRH — altrimenti il deploy risponde 401 Unauthorized.
  Genera il token: https://central.sonatype.com/usertoken
  (documentazione: https://central.sonatype.org/publish/generate-portal-token/ )

  In Jenkins: credenziale «Username with password» con ID `sonatype-ossrh` (default del parametro
  SONATYPE_CREDENTIALS_ID nel Jenkinsfile). Username/password = valori del Portal user token
  mostrati alla generazione.

  Nel file settings Maven, <server><id> deve essere esattamente ossrh (come in distributionManagement
  del pom) — non confondere con l’ID della credenziale Jenkins (`sonatype-ossrh`).

  NON versionare username/password reali.
  Per locale: sonatype-settings.local.xml (gitignored) o merge in ~/.m2/settings.xml.

  Dopo maven-deploy (API "Maven-like"): per far comparire il deployment nel Portal può essere
  necessario POST /manual/upload/defaultRepository/<namespace> dallo stesso IP — vedi
  https://central.sonatype.org/publish/publish-portal-ossrh-staging-api/
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>ossrh</id>
      <username>SONATYPE_USERNAME</username>
      <password>SONATYPE_PASSWORD</password>
    </server>
  </servers>
</settings>
